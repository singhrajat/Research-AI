NODE_ENV=development
PORT=3000
STOP_ALL_LOGS=false

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2000
OPENAI_BRS_REVIEWER_MODEL=o4-mini

MODEL_REGISTRY=[{"id":"gpt-4o-mini","tier":1,"reasoningClass":false,"supportsStructuredOutput":true,"contextWindow":128000},{"id":"gpt-4o","tier":2,"reasoningClass":false,"supportsStructuredOutput":true,"contextWindow":128000},{"id":"o4-mini","tier":3,"reasoningClass":true,"supportsStructuredOutput":true,"contextWindow":200000}]
MAX_TIER=3

LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

TAVILY_API_KEY=your_tavily_api_key
